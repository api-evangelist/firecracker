          "name": "Gets the machine configuration of the VM.",
          "request": {
            "name": "Gets the machine configuration of the VM.",
            "description": {
              "content": "Gets the machine configuration of the VM. When called before the PUT operation, it will return the default values for the vCPU count (=1), memory size (=128 MiB). By default SMT is disabled and there is no CPU Template.",
              "type": "text/plain"
            },
