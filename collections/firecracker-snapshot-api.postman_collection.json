              "raw": "{\n  \"snapshot_path\": \"<string>\",\n  \"enable_diff_snapshots\": \"<boolean>\",\n  \"track_dirty_pages\": \"<boolean>\",\n  \"mem_file_path\": \"<string>\",\n  \"mem_backend\": {\n    \"backend_type\": \"<string>\",\n    \"backend_path\": \"<string>\"\n  },\n  \"resume_vm\": \"<boolean>\",\n  \"network_overrides\": [\n    {\n      \"iface_id\": \"<string>\",\n      \"host_dev_name\": \"<string>\"\n    },\n    {\n      \"iface_id\": \"<string>\",\n      \"host_dev_name\": \"<string>\"\n    }\n  ],\n  \"vsock_override\": {\n    \"uds_path\": \"<string>\"\n  },\n  \"clock_realtime\": \"<boolean>\"\n}",
