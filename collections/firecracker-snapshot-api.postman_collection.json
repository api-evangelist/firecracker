          "name": "Loads a snapshot. Pre-boot only.",
          "request": {
            "name": "Loads a snapshot. Pre-boot only.",
            "description": {
              "content": "Loads the microVM state from a snapshot. Only accepted on a fresh Firecracker process (before configuring any resource other than the Logger and Metrics).",
